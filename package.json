{
  "name": "hedgenet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "node node_modules/next/dist/bin/next dev apps/web --hostname 127.0.0.1",
    "dev:local": "node --env-file-if-exists=.env tools/dev-local.mjs",
    "build:web": "pnpm --filter @hedgenet/web build",
    "demo:foundation": "node examples/financial-foundation.ts",
    "catalogue": "node tools/catalogue.ts",
    "lab:check": "node tools/lab.mjs"
  },
  "dependencies": {
    "@hedgenet/core": "workspace:*",
    "@hedgenet/venue": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "next": "16.4.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
